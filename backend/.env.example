# Variables de entorno de ejemplo para el Backend (NestJS)
PORT=4000
NODE_ENV=development

# Base de datos PostgreSQL (Supabase, Neon, etc.)
DATABASE_URL="postgresql://usuario:password@host:5432/postgres"

# Seguridad JWT
JWT_SECRET="tu_clave_secreta_jwt_para_firmar_tokens"
JWT_EXPIRES_IN="7d"

# Correo Transaccional (Gmail SMTP con Contraseña de Aplicación de 16 caracteres)
GMAIL_USER="notificaciones.estetica@gmail.com"
GMAIL_APP_PASS="xxxx xxxx xxxx xxxx"

# Orígenes Permitidos (CORS)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,https://tu-dominio.com"
